{
  "manifest_version": 2,
  "name": "Strip Clickbait",
  "version": "1.0.0",
  "description": "Translate clickbait links into descriptive AI summaries.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "src/background/index.js"
    ],
    "persistent": false,
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true,
    "browser_style": true
  }
}